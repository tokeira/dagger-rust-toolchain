# Cargo packages: the collection of one workspace's members, one package,
# and the package-level checks and generator. Each forwards to its lane's
# file.
#
# The delta and narrowed members of RustPackages are adapted from go.dang in
# dagger.io/go (https://github.com/dagger/go), Copyright 2022 Dagger, Inc.,
# licensed under the Apache License, Version 2.0. See NOTICE.

"""
A member package of a Cargo workspace.
"""
type RustMember {
  """
  Package directory, relative to the repository root.
  """
  path: String!

  """
  Package name, as Cargo's -p flag takes it.
  """
  name: String!
}

"""
The member packages of one Cargo workspace, keyed by directory.

Directories are relative to the repository root. Under the wholeWorkspace
setting the collection has one item, keyed by the workspace root, which
stands for every member.
"""
type RustPackages @collection {
  """
  Package directories, relative to the repository root.

  Under the wholeWorkspace setting, the workspace root alone.
  """
  paths: [String!]! @keys

  """
  Packages selected in or out since the collection was discovered.
  """
  delta: CollectionDelta @delta

  # Every member of the workspace, selected or not. The engine filters paths
  # when it passes a selection; this list stays whole.
  let members: [RustMember!]!

  let workspace: RustWorkspace!
  let inputs: RustInputs!

  # The repository's files, which a whole-workspace test run sees: under the
  # wholeWorkspace setting RustWorkspace.repositoryOf, and otherwise empty.
  let repository: Directory!

  """
  Whether the selection left packages of the workspace out.
  """
  narrowed: Boolean! {
    delta == null or delta!.addedKeys.length > 0 or delta!.removedKeys.length > 0
  }

  # Whether the collection is one item that stands for every member: the
  # wholeWorkspace setting.
  let whole: Boolean! { workspace.tool.wholeWorkspace }

  # The selected members that patterns select too, in key order: the packages
  # a lane's shared step covers. The one item of a whole workspace selects
  # every member.
  let selected(patterns: [String!]!): [RustMember!]! {
    members.filter { member =>
      (whole or paths.contains(member.path)) and rustSelects(patterns, member.path)
    }
  }

  # How a shared Cargo command names the packages it covers: --workspace when
  # the selection and the patterns leave no member out, and otherwise -p for
  # each one. It raises when they leave every member out: Cargo, given no
  # package, would run on them all.
  let packageFlags(patterns: [String!]!): [String!]! {
    let chosen = selected(patterns)
    let none: [String!]! = []
    if (chosen.length == 0) {
      raise "rust: no package of the workspace " + workspace.path + " is selected"
    }
    if ((whole or narrowed == false) and chosen.length == members.length) {
      ["--workspace"]
    } else {
      chosen.reduce(none) { flags, member => flags + ["-p", member.name] }
    }
  }

  """
  The package in this directory.

  Under the wholeWorkspace setting, the item at the workspace root: every
  member as one.
  """
  package(path: String!): RustPackage! @get {
    let none: [RustMember!]! = []
    if (whole) {
      RustPackage(path: path, name: "", workspace: workspace, inputs: inputs, members: members)
    } else {
      RustPackage(
        path: path,
        name: members.filter { member => member.path == path }[0]!.name,
        workspace: workspace,
        inputs: inputs,
        members: none,
      )
    }
  }
}

"""
A Cargo package.

Under the wholeWorkspace setting it is the one item of its workspace, at the
workspace root, and stands for every member.
"""
type RustPackage {
  """
  Package directory, relative to the repository root.

  Under the wholeWorkspace setting, the workspace root.
  """
  path: String!

  """
  Package name. Empty under the wholeWorkspace setting.
  """
  name: String!

  let workspace: RustWorkspace!
  let inputs: RustInputs!

  # Every member of the workspace, when this item stands for them all under
  # the wholeWorkspace setting, and otherwise none.
  let members: [RustMember!]!

  # Whether this item stands for every member: it then holds them. A member
  # that a lane makes into a package of its own holds none.
  let whole: Boolean! { members.length > 0 }

  # Whether patterns leave this package out. A whole workspace is left out
  # when they leave out every member.
  let leftOut(patterns: [String!]!): Boolean! {
    if (whole) {
      members.any { member => rustSelects(patterns, member.path) } == false
    } else {
      rustSelects(patterns, path) == false
    }
  }

  """
  Whether the clippy setting leaves this package out.
  """
  skipClippy: Boolean! { leftOut(workspace.tool.clippy) }

  """
  Whether the test setting leaves this package out.
  """
  skipTest: Boolean! { leftOut(workspace.tool.test) }

  """
  Format this package with rustfmt.

  Under the wholeWorkspace setting, every package of the workspace.
  """
  fmt: Changeset! @generate {
    rustFmtLane(self)
  }

  """
  Lint this package with clippy.

  Under the wholeWorkspace setting, every package of the workspace that the
  clippy setting selects, as one check.
  """
  clippy(selection: RustPackages!): Void @check {
    if (skipClippy == false) {
      rustClippyLane(self, selection)
    }
    null
  }

  """
  Run this package's tests.

  Under the wholeWorkspace setting, those of every package of the workspace
  that the test setting selects, in one run over a writable copy of the
  whole repository.
  """
  test(selection: RustPackages!): Void @check {
    if (skipTest == false) {
      rustTestLane(self, selection)
    }
    null
  }
}
